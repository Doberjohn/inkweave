# Reveal-season flag. When 'true', /reveals route, nav entry, and promo modal activate.
# Default: false.
VITE_IS_REVEAL_SEASON=false

# Strategy Tips flag. When 'true', the collapsible "Strategy Tips" section renders
# on /playstyles/:id detail pages. Turn off in production until the copy is reviewed;
# keep on in .env.local for dev. Vercel toggles this via its env-var dashboard.
# Default: false.
VITE_SHOW_STRATEGY_TIPS=false

# Beta-notice flag. When 'true', the home page shows a card saying the site (or, with
# collection mode on, the collection) is in beta, thanking testers and linking the
# Discord: above the logo on narrower screens, in the top-left corner on wide ones
# (index.css's `.beta-notice`).
# Production has it on; turn it off when the beta ends.
# Default: true (show notice until explicitly turned off).
VITE_SHOW_BETA_NOTICE=true

# PostHog (EU cloud) project API key, phc_…, public by design like Sentry's DSN. Set it in
# Vercel for Production only: staging and PR previews build with Preview values, and the free
# plan has one project. Unset, the app never loads PostHog; dev builds never load it either.
# The PostHog project needs "Cookieless tracking" on (formerly "Cookieless server hash mode"),
# or it drops every event, and should discard client IP data (see shared/lib/posthogClient.ts).
# VITE_POSTHOG_KEY=

# Build-time only, and NOT read from this file or .env.local: download-card-images.mjs
# runs as plain `node` with no dotenv, so it sees only the real process environment.
# Set them in the Vercel env UI, or export them in the shell for a local run.
# Card-image RESTORE (#554): on a cache miss, download-card-images.mjs
# fetches the already-converted AVIF from a deployment instead of re-downloading and
# re-encoding from Ravensburger, verifying the bytes hash to what the deployment
# publishes. Both are optional, restore is an optimisation and every failure path
# falls through to the normal download.
# PROD_IMAGE_ORIGIN=     # override the restore origin; otherwise VERCEL_PROJECT_PRODUCTION_URL
#                        # (automatic on Vercel) then https://inkweave.ink
# SKIP_IMAGE_RESTORE=1   # disable restore entirely, reverting to pure download behaviour
