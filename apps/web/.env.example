# Reveal-season flag. When 'true', /reveals route, nav entry, and promo modal activate.
# Default: false.
VITE_IS_REVEAL_SEASON=false

# Strategy Tips flag. When 'true', the collapsible "Strategy Tips" section renders
# on /playstyles/:id detail pages. Turn off in production until the copy is reviewed;
# keep on in .env.local for dev. Vercel toggles this via its env-var dashboard.
# Default: false.
VITE_SHOW_STRATEGY_TIPS=false

# Beta-notice flag. When 'true', a desktop-only floating card on the landing page
# warns visitors the site is in beta. Turn off at v1.0.0 launch (when the banner
# is no longer appropriate). Sticky-dismissed per user via localStorage.
# Default: true (show notice until explicitly turned off).
VITE_SHOW_BETA_NOTICE=true

# Featured card IDs on the landing page "Popular Synergy Starters" row.
# Comma-separated string of card IDs (no spaces required). Vite inlines this at
# build time, so changing it on Vercel requires a redeploy. Recommend exactly 6
# IDs so the desktop 6-col / mobile 3x2 grid stays symmetrical. Unknown IDs or
# cards missing images are silently skipped. Falls back to the in-code defaults
# in apps/web/src/features/cards/components/FeaturedCards.tsx when unset.
# Example: VITE_FEATURED_CARD_IDS=13028,13051,13082,13125,13158,13197
# VITE_FEATURED_CARD_IDS=

# Build-time only (NOT a VITE_ var, never shipped to the client). When set, the
# vote-analytics precompute reads the raw votes table for weekly activity, distinct
# voter counts, and dimension-participation stats. Without it, the analytics artifact
# still builds from the anon-readable pair_scores view (core gap/rule/pair data).
# SUPABASE_SERVICE_ROLE_KEY=

# Build-time only (NOT VITE_ vars, never shipped to the client). Power the Web
# Analytics tab in /admin/analytics: the precompute queries the Vercel Web Analytics
# Query API for custom-event totals + breakdowns and bakes vercel-analytics.json.
# Without the token/project id the tab shows a no-data notice and the build stays green.
# VERCEL_ANALYTICS_TOKEN=            # Vercel access token, read scope
# VERCEL_PROJECT_ID=                 # prj_... of the Inkweave project
# VERCEL_TEAM_ID=                    # team_... (omit for a personal-account project)
# VERCEL_ANALYTICS_WINDOW_DAYS=90    # trend/breakdown lookback in days (optional, default 90)

# Admin analytics dashboard flag. When 'true', the /admin/analytics route renders;
# otherwise it redirects to /. Unlisted route, no nav entry. Default: false.
VITE_SHOW_ADMIN_ANALYTICS=false
