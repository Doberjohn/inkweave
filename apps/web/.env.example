# Accounts flag. When 'true', the header renders the sign-in control. Off hides the
# ONLY discoverable way in; /account and /auth/callback stay mounted either way, so
# the surface is testable by URL and the OAuth provider's redirect target never 404s.
# Shipped off until there is something to do with an account (#474, 2026-10-01).
# Default: false.
VITE_SHOW_ACCOUNTS=false

# Collection flag (#553 Phase C). When 'true', Browse gains its collection mode (the
# binder) and /account its Dreamborn import section, and the collection providers
# mount. Off, none of the collection UI is loaded. REQUIRES VITE_SHOW_ACCOUNTS=true
# as well: the Collection button asks a signed-out visitor to sign in, so it is
# ignored while accounts are off (see features/collection/flag.ts).
# Default: false.
VITE_SHOW_COLLECTION=false

# Reveal-season flag. When 'true', /reveals route, nav entry, and promo modal activate.
# Default: false.
VITE_IS_REVEAL_SEASON=false

# Strategy Tips flag. When 'true', the collapsible "Strategy Tips" section renders
# on /playstyles/:id detail pages. Turn off in production until the copy is reviewed;
# keep on in .env.local for dev. Vercel toggles this via its env-var dashboard.
# Default: false.
VITE_SHOW_STRATEGY_TIPS=false

# Beta-notice flag. When 'true', a desktop-only floating card on the landing page
# warns visitors the site is in beta. Turn off at v1.0.0 launch (when the banner
# is no longer appropriate). Sticky-dismissed per user via localStorage.
# Default: true (show notice until explicitly turned off).
VITE_SHOW_BETA_NOTICE=true

# Featured card IDs on the landing page "Popular Synergy Starters" row.
# Comma-separated string of card IDs (no spaces required). Vite inlines this at
# build time, so changing it on Vercel requires a redeploy. Recommend exactly 6
# IDs so the desktop 6-col / mobile 3x2 grid stays symmetrical. Unknown IDs or
# cards missing images are silently skipped. Falls back to the defaults in
# apps/web/src/features/cards/featuredCardIds.json when unset.
# scripts/precompute-synergies.mjs reads it too, for /data/featuredCards.json (#641).
# Example: VITE_FEATURED_CARD_IDS=3286,3318,3354,3386,3423,3461
# VITE_FEATURED_CARD_IDS=

# Opt-out for the react-grab dev inspector that index.html loads under `pnpm dev`.
# Playwright's webServer pins it to 'true', so E2E pages never load the inspector.
# Leave unset to keep it in local dev; production builds never include it.
# VITE_DISABLE_REACT_GRAB=true

# PostHog (EU cloud) project API key, phc_…, public by design like Sentry's DSN. Set it in
# Vercel for Production only: staging and PR previews build with Preview values, and the free
# plan has one project. Unset, the app never loads PostHog; dev builds never load it either.
# The PostHog project needs "Cookieless tracking" on (formerly "Cookieless server hash mode"),
# or it drops every event, and should discard client IP data (see shared/lib/posthogClient.ts).
# VITE_POSTHOG_KEY=

# Build-time only, and NOT read from this file or .env.local: download-card-images.mjs
# runs as plain `node` with no dotenv, so it sees only the real process environment.
# Set them in the Vercel env UI, or export them in the shell for a local run.
# Card-image RESTORE (#554): on a cache miss, download-card-images.mjs
# fetches the already-converted AVIF from a deployment instead of re-downloading and
# re-encoding from Ravensburger, verifying the bytes hash to what the deployment
# publishes. Both are optional, restore is an optimisation and every failure path
# falls through to the normal download.
# PROD_IMAGE_ORIGIN=     # override the restore origin; otherwise VERCEL_PROJECT_PRODUCTION_URL
#                        # (automatic on Vercel) then https://inkweave.ink
# SKIP_IMAGE_RESTORE=1   # disable restore entirely, reverting to pure download behaviour
