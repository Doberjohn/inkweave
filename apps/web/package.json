{
  "name": "inkweave-web",
  "version": "0.1.0",
  "private": true,
  "description": "Discover synergistic card combinations for Disney Lorcana TCG",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "pnpm dlx @react-grab/claude-code@latest && vite",
    "build": "tsc -b && vite build",
    "typecheck": "pnpm --filter inkweave-synergy-engine build && tsc -b",
    "build:storybook": "storybook build -o dist/storybook",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:update": "vitest run --coverage && node scripts/update-coverage-badge.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:stories": "node scripts/check-story-coverage.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.17",
    "@sentry/react": "^10.62.0",
    "@supabase/supabase-js": "^2.108.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "inkweave-synergy-engine": "workspace:*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-loading-skeleton": "^3.5.0",
    "react-router-dom": "^7.18.0",
    "react-virtuoso": "^4.18.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@react-grab/claude-code": "^0.1.29",
    "@rolldown/plugin-babel": "^0.2.3",
    "@sentry/vite-plugin": "^5.3.0",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-onboarding": "^10.4.6",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "~4.1.9",
    "@vitest/coverage-v8": "~4.1.9",
    "axe-core": "^4.12.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-storybook": "^10.4.6",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "react-grab": "^0.1.47",
    "rollup-plugin-visualizer": "^7.0.1",
    "storybook": "^10.4.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "~4.1.9",
    "vitest-axe": "^0.1.0",
    "workbox-window": "^7.4.1"
  }
}
