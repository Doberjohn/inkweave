{
  "projectId": "a0ed7aa8-a3a4-4663-bb98-7a13b43de7dc",
  "shape": "storybook",
  "pkg": "inkweave-web",
  "globalName": "Inkweave",

  "entry": ".design-sync/entry.tsx",
  "buildCmd": "node .design-sync/gen-entry.mjs && pnpm --filter inkweave-web exec tsc -p ../../.design-sync/tsconfig.dts.json",

  "storybookConfigDir": "apps/web/.storybook",
  "storybookStatic": ".design-sync/sb-reference",

  "srcDir": "apps/web/src",
  "cssEntry": "apps/web/src/index.css",
  "extraFonts": [".design-sync/fonts.css"],

  "extraEntries": [
    "./.design-sync/entry.tsx",
    "./.design-sync/providers.tsx",
    "react-router-dom"
  ],

  "storyImports": {
    "shim": ["shared/contexts/"]
  },

  "readmeHeader": ".design-sync/conventions.md",

  "guidelinesGlob": [
    "docs/UX_REFERENCE.md",
    "docs/UX_AUDIT.md",
    "docs/TECH_STACK.md",
    "docs/DESIGN_SYSTEM_MIRROR.md"
  ],

  "provider": {
    "component": "InkweaveDesignRoot",
    "inner": {"component": "SessionProvider"}
  },

  "titleMap": {
    "Colors": null,
    "MicroPatterns": null,
    "Spacing&Layout": null,
    "Typography": null,
    "HealthVariants": "PrioritiesView"
  },

