{
  "name": "inkweave-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Inkweave's design tokens and shared UI components, consumed as source by the app and admin",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./tokens/*": "./src/tokens/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./lorcana/*": "./src/lorcana/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./utils/*": "./src/utils/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./assets/*": "./src/assets/*",
    "./styles/*.css": "./src/styles/*.css"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "inkweave-synergy-engine": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.4",
    "@storybook/react-vite": "^10.6.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "~5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "~5.0.5"
  }
}
