{
  // The app's compiler options, for the package's own source, tests and configs: only the build
  // info file, the ambient types and the files differ. The app type-checks the modules it imports
  // from here as part of its own tsc -b.
  "extends": "../../apps/web/tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "types": ["vite/client", "vitest/globals", "node"],
    // The package takes only types from the engine (tokens/lorcana.ts's Ink), so it reads them
    // from the engine's source and its type-check needs no engine build. A value import from the
    // engine fails here, as it should.
    "paths": {"inkweave-synergy-engine": ["../synergy-engine/src/types/index.ts"]}
  },
  "include": ["src", "vitest.config.ts"]
}
