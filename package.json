{
  "name": "inkweave",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for Inkweave - Disney Lorcana synergy finder",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter inkweave-web dev",
    "build": "pnpm -r build",
    "build:engine": "pnpm --filter inkweave-synergy-engine build",
    "build:web": "pnpm --filter inkweave-web build",
    "build:vercel": "node scripts/write-version.mjs && node scripts/convert-preview-images.mjs && node scripts/download-card-images.mjs && pnpm build:engine && node scripts/precompute-synergies.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-card-slug-map.mjs && VITE_LOCAL_IMAGES=true pnpm build:web && (pnpm --filter inkweave-web exec playwright install chromium && node scripts/prerender.mjs || echo '[prerender] crawl failed or unavailable in this environment \u2014 shipping SPA-only (safe fallback, no regression)')",
    "test": "pnpm -r test:run",
    "test:engine": "pnpm --filter inkweave-synergy-engine test:run",
    "test:web": "pnpm --filter inkweave-web test:run",
    "test:e2e": "pnpm --filter inkweave-web test:e2e",
    "test:e2e:ui": "pnpm --filter inkweave-web test:e2e:ui",
    "test:supabase": "node scripts/test-supabase-integration.mjs",
    "bench:engine": "pnpm --filter inkweave-synergy-engine bench:run",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "size-limit",
    "download-images": "node scripts/download-card-images.mjs",
    "convert-preview-images": "node scripts/convert-preview-images.mjs",
    "precompute-synergies": "node scripts/precompute-synergies.mjs",
    "precompute-vote-analytics": "node scripts/precompute-vote-analytics.mjs",
    "precompute-vercel-analytics": "node scripts/precompute-vercel-analytics.mjs",
    "generate-sitemap": "node scripts/generate-sitemap.mjs",
    "generate-card-slug-map": "node scripts/generate-card-slug-map.mjs",
    "prerender": "node scripts/prerender.mjs",
    "test:scripts": "vitest run --config vitest.scripts.config.mjs",
    "mine-rules": "pnpm build:engine && node scripts/mine-rule-candidates.mjs",
    "graduate-set": "node scripts/graduate-canonical-set.mjs",
    "sync-variants": "node scripts/sync-variants.mjs",
    "banner": "node scripts/export-banner.mjs",
    "docs": "node scripts/generate-docs.mjs",
    "analyze": "ANALYZE=true pnpm build:web",
    "prepare": "husky"
  },
  "size-limit": [
    {
      "name": "User-facing JS",
      "path": [
        "apps/web/dist/assets/*.js",
        "!apps/web/dist/assets/RevealsPage-*.js",
        "!apps/web/dist/assets/RevealAdminPage-*.js",
        "!apps/web/dist/assets/AdminAnalyticsPage-*.js",
        "!apps/web/dist/assets/ImageAdminPage-*.js",
        "!apps/web/dist/assets/TuningAdminPage-*.js"
      ],
      "limit": "370 kB",
      "gzip": true
    },
    {
      "name": "Entry chunk",
      "path": "apps/web/dist/assets/index-*.js",
      "limit": "127 kB",
      "gzip": true
    },
    {
      "name": "Admin & flag-gated JS",
      "path": [
        "apps/web/dist/assets/RevealsPage-*.js",
        "apps/web/dist/assets/RevealAdminPage-*.js",
        "apps/web/dist/assets/AdminAnalyticsPage-*.js",
        "apps/web/dist/assets/ImageAdminPage-*.js",
        "apps/web/dist/assets/TuningAdminPage-*.js"
      ],
      "limit": "60 kB",
      "gzip": true
    },
    {
      "name": "Card data JSON",
      "path": "apps/web/dist/data/allCards.json",
      "limit": "360 kB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "vitest": "^5.0.2",
    "@size-limit/file": "^14.0.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "size-limit": "^14.0.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=24 <25"
  }
}
