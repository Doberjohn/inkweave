// Dead-code check. CI runs `pnpm knip`, whose --include fails it on unused files and
// dependencies, unlisted dependencies and binaries, unresolved imports, and an export, type or
// enum member nothing imports, or one exported twice. An export only another repo or branch
// reads, such as a name inkweave-admin's src/app-bridge.ts takes, keeps its `export` with a
// `/** @public */` tag and a comment naming the reader.
{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Generated by Supabase, which exports its helpers whether the app uses them or not.
  "ignoreIssues": {"apps/web/src/shared/lib/database.types.ts": ["exports", "types"]},
  "workspaces": {
    ".": {
      // Run from places knip doesn't read: vercel.json's buildCommand, .husky/pre-push and the
      // .claude/hooks shell scripts.
      "entry": [
        "scripts/check-sourcemaps.mjs",
        "scripts/codescene-gate.mjs",
        "scripts/pre-push-cloud-e2e.mjs",
        ".claude/hooks/lib/run-hook.mjs",
      ],
      // Root scripts load these from apps/web on purpose, through createRequire.
      "ignoreDependencies": ["@playwright/test", "@supabase/supabase-js"],
      // generate-docs.mjs opens the docs hub with the system's own opener.
      "ignoreBinaries": ["xdg-open"],
    },
    "packages/synergy-engine": {
      // tsup.config.ts's onSuccess runs it after every engine build (catalog.json, #930).
      "entry": ["scripts/write-catalog.mjs"],
    },
  },
}
