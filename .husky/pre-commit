#!/bin/sh
. "$(dirname "$0")/handoff.sh"

# Lint runs beside the tests, its output held until they finish so the two
# don't interleave; the commit goes through only when both pass. Each lint
# script keeps an ESLint cache in its package's node_modules/.cache/eslint/,
# so a repeat lint re-lints only the files that changed.
# A cold lint (no cache yet: a fresh install, or the cache deleted) reads every
# file and loads the same heavy plugins as the tests that start an ESLint
# (packages/ui's lintConfig.test.ts), so it runs first, as it used to.
if [ ! -d apps/web/node_modules/.cache/eslint ]; then
  pnpm run lint && pnpm run test
  exit $?
fi
lint_log=$(mktemp)
pnpm run lint >"$lint_log" 2>&1 &
lint_pid=$!
# Stop lint and drop its log however the hook ends, Ctrl-C included.
trap 'rc=$?; kill "$lint_pid" 2>/dev/null || :; rm -f "$lint_log"; exit $rc' EXIT
trap 'exit 130' INT TERM
test_rc=0
pnpm run test || test_rc=$?
lint_rc=0
wait "$lint_pid" || lint_rc=$?
cat "$lint_log"
rm -f "$lint_log"
[ "$lint_rc" -eq 0 ] || echo "pre-commit: lint failed (exit $lint_rc)"
[ "$test_rc" -eq 0 ] || echo "pre-commit: tests failed (exit $test_rc)"
[ "$lint_rc" -eq 0 ] && [ "$test_rc" -eq 0 ]
