#!/bin/sh
# Story coverage gate — fails fast (~130ms) if a new visual component shipped
# without a .stories.tsx file. Mirrors the chromatic.yml CI check so missing
# stories surface locally before the Chromatic run rejects the push.
pnpm --filter inkweave-web check:stories || exit $?

# Run chromium + webkit + mobile-chrome pre-push.
# - Chromium alone misses WebKit-specific stacking-context bugs and Safari
#   focus quirks.
# - Mobile-chrome catches touch-event regressions that desktop browsers don't
#   see: Playwright's .click() on mobile projects fires touchstart → synthetic
#   click (the real iOS/Android tap sequence). Desktop .click() is mouse-only.
# Firefox + mobile-safari still run in CI only (pre-push time budget).
pnpm --filter inkweave-web test:e2e --project chromium --project webkit --project mobile-chrome || exit $?

# CodeScene quality gate — mirrors the CI check so failed branches never reach origin.
# Tries the MCP server first; falls back to requiring CODESCENE_OK=1 when
# CodeScene MCP isn't reachable from the local environment (auth/license).
node scripts/codescene-gate.mjs
